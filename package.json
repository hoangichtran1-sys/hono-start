{
    "name": "hono_start",
    "module": "index.ts",
    "type": "module",
    "private": true,
    "devDependencies": {
        "@types/bun": "latest",
        "@types/pg": "^8.23.1",
        "@types/unique-slug": "^4.0.0",
        "pino-pretty": "^13.1.3"
    },
    "scripts": {
        "dev": "bun run --hot src/index.ts",
        "start": "NODE_ENV=production bun run stc/index.ts",
        "build:types": "tsc --project tsconfig.build.json",
        "types:check": "bun x tsc --noEmit",
        "get-types": "curl -o src/types/backend.d.ts https://raw.githubusercontent.com/username/repo-backend/main/dist/index.d.ts",
        "migration:generate": "bun --bun typeorm migration:generate -d src/configs/db.ts",
        "migration:run": "bun --bun typeorm migration:run -d src/configs/db.ts",
        "migration:revert": "bun --bun typeorm migration:revert -d src/configs/db.ts"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "dependencies": {
        "@hono/standard-validator": "^0.4.0",
        "@scalar/hono-api-reference": "^0.12.9",
        "cloudinary": "^2.11.0",
        "date-fns": "^4.4.0",
        "hono": "^4.13.9",
        "hono-openapi": "^1.3.3",
        "hono-rate-limiter": "^0.5.4",
        "http-status-codes": "^2.3.0",
        "nanoid": "^6.0.1",
        "pg": "^8.23.0",
        "pg-query-stream": "^4.17.0",
        "pino": "^10.3.1",
        "reflect-metadata": "^0.2.2",
        "typeorm": "^1.1.1",
        "unique-slug": "^7.0.0",
        "zod": "^4.6.5"
    }
}
